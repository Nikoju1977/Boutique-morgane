{
  "name": "morgane-medium",
  "main": "index.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "../client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "morgane-medium",
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ]
}